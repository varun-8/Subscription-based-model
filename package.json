{
    "name": "magazine-erp-desktop",
    "version": "1.0.0",
    "description": "Magazine ERP Desktop Application",
    "author": "MagAdmin",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "seed": "node server/seed_sample_data.js",
        "build:client": "cd client && npm run build",
        "dist": "npm run build:client && electron-builder --win nsis portable",
        "dist:installer": "npm run build:client && electron-builder --win nsis",
        "dist:portable": "npm run build:client && electron-builder --win portable",
        "package:win": "npm run build:client && electron-packager . \"Aachi Vanthachu\" --platform=win32 --arch=x64 --out=dist-packager --overwrite --ignore=\"client/(src|public|node_modules)\" --ignore=\"^dist$\" --ignore=\"^dist-packager$\" --ignore=\"^builder_cache$\" --ignore=\"^\\.git$\" --ignore=\"^resources$\""
    },
    "devDependencies": {
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "electron-packager": "^17.1.2"
    },
    "dependencies": {
        "axios": "^1.13.5",
        "node-machine-id": "^1.1.12",
        "pptxgenjs": "^4.0.1",
        "tree-kill": "^1.2.2"
    },
    "build": {
        "appId": "com.magazine.erp",
        "productName": "Aachi Vanthachu",
        "directories": {
            "output": "release"
        },
        "files": [
            "electron/main.js",
            "electron/preload.js",
            "electron/splash.html",
            "electron/logo.png",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "server",
                "to": "server",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "server/.env",
                "to": "server/.env"
            },
            {
                "from": "client/dist",
                "to": "client/dist",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "icon": "electron/logo.png",
            "target": [
                "nsis",
                "portable"
            ],
            "forceCodeSigning": false
        }
    }
}
